 int [] nums = {3,2,5,21,8,7,22};
 ----------
 
 int f=0,s=0,t=0; 
 
 for( int num : nums){
   
   if( num>=f){
     t=s;
     s=f;
     f=num;
     
   }
   else if (num>=s) {
      t=s;
     s=num;
   }
    else if (num>=t) {
      t=num;
   }
 }
 
 
