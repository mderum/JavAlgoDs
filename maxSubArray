  public static int maxSubArray(int[] nums) {
        int maxSoFar = nums[0];        // Stores the final result  -2
        int currentMax = nums[0];      // Stores max ending at current position -2 
 
        for (int i = 1; i < nums.length; i++) { -3 4 -1 2 1 -5 4
            currentMax = Math.max(nums[i], currentMax + nums[i]); // Extend or restart// 1 -2 4 3 5 6 1 5
            maxSoFar = Math.max(maxSoFar, currentMax);             // Update result if needed 1  4  5 6 
        }

        return maxSoFar;
    }

    public static void main(String[] args) {
        int[] nums = {-2,1,-3,4,-1,2,1,-5,4};
        System.out.println("Maximum Subarray Sum: " + maxSubArray(nums));
    }
